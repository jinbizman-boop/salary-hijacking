# EAS archive rules for Salary Hijacking mobile builds.
# This intentionally differs from .gitignore so the CI-generated Android
# Firebase config can be uploaded to EAS without being committed.

node_modules/
.expo/
dist/
build/
coverage/
android/
ios/
*.log
*.tmp
*.temp
.DS_Store
Thumbs.db

# Keep local credential directories out of archives.
secrets/
GoogleService-Info.plist
**/GoogleService-Info.plist

# The production workflow writes this CI-only Firebase file from a GitHub
# environment secret immediately before invoking EAS. It intentionally uses a
# production-specific path that is not hidden by the app's local .gitignore.
!firebase-production-google-services.json

# Runtime image assets are required by the Android JS bundle. Keep them explicit
# because EAS uses archive ignore rules before the remote Metro bundle phase.
!src/
!src/shared/
!src/shared/assets/
!src/shared/assets/**
!assets/runtime-icons/**
!assets/runtime-images/**
